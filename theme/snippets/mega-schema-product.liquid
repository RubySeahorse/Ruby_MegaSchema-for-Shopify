{%- doc -%}
  Outputs the product node for the MegaSchema @graph. Products with more than one variant output a
  ProductGroup with one Product per variant in hasVariant; single-variant products output one Product.
  Offers reference the return and shipping nodes from snippets/mega-schema-site.liquid. Products tagged
  with a final-sale tag from theme settings reference the final-sale return policy instead.
  The node is preceded by a comma; snippets/mega-schema.liquid removes the leading one.
  The product's @id is the bare product URL, because review apps such as Bazaarvoice attach their
  aggregateRating and review JSON-LD to the node with that exact @id.
  The company is named as manufacturer only when the vendor is the shop name or one of the brands in
  the "Brands" theme setting, so resold products from other companies do not claim it. Barcodes are
  output as GTINs only when they are 8, 12, 13 or 14 digits with a valid GS1 check digit.

  @param {string} site_url - The store's primary URL without a trailing slash
{%- enddoc -%}

{%- liquid
  assign org_id = site_url | append: '/#organization'
  assign shipping_id = site_url | append: '/#shipping_policy'
  assign product_url = site_url | append: product.url
  assign schema_currency = cart.currency.iso_code
  assign vendor_handle = product.vendor | handleize
  assign brand_id = site_url | append: '/#brand-' | append: vendor_handle

  assign vendor_key = product.vendor | strip | downcase
  assign is_own_brand = false
  assign shop_key = shop.name | strip | downcase
  if vendor_key != blank and vendor_key == shop_key
    assign is_own_brand = true
  endif
  assign owned_brands = settings.schema_brands | split: ','
  for owned_brand in owned_brands
    assign owned_key = owned_brand | strip | downcase
    if owned_key != blank and owned_key == vendor_key
      assign is_own_brand = true
    endif
  endfor

  assign is_group = true
  if product.has_only_default_variant or product.variants.size == 1
    assign is_group = false
  endif
  assign product_id = product_url

  assign return_ref = site_url | append: '/#return_policy'
  assign final_sale_tags = settings.schema_final_sale_tags | split: ','
  for final_sale_tag in final_sale_tags
    assign clean_tag = final_sale_tag | strip
    if clean_tag != blank and product.tags contains clean_tag
      assign return_ref = site_url | append: '/#return_policy_final_sale'
      break
    endif
  endfor

  assign color_index = -1
  assign size_index = -1
  for product_option in product.options_with_values
    assign option_name = product_option.name | downcase | strip
    if option_name == 'color' or option_name == 'colour' or option_name == 'cover color'
      assign color_index = forloop.index0
    elsif option_name == 'size'
      assign size_index = forloop.index0
    endif
  endfor

  assign product_description = product.description | newline_to_br | replace: '<', ' <' | strip_html | strip_newlines | replace: '&amp;', '&' | replace: '&nbsp;', ' ' | replace: '&quot;', '"' | replace: '&#39;', "'" | split: ' ' | join: ' ' | strip | truncate: 5000
  if product_description == blank
    assign product_description = product.metafields.global.description_tag.value | strip
  endif

  assign product_category = product.category.name
  if product_category == blank
    assign product_category = product.type
  endif

  assign property_count = 0
  capture additional_properties
    assign product_line = product.metafields.custom.product_brand.value | strip
    if product_line != blank and product_line != product.vendor
      echo '{"@type":"PropertyValue","name":"Product line","value":'
      echo product_line | json
      echo '}'
      assign property_count = property_count | plus: 1
    endif
    assign fit_value = product.metafields.custom.grill_type.value | strip
    if fit_value != blank
      if property_count > 0
        echo ','
      endif
      echo '{"@type":"PropertyValue","name":"Grill type","value":'
      echo fit_value | json
      echo '}'
      assign property_count = property_count | plus: 1
    endif
    assign fit_value = product.metafields.custom.rv_type.value | strip
    if fit_value != blank
      if property_count > 0
        echo ','
      endif
      echo '{"@type":"PropertyValue","name":"RV type","value":'
      echo fit_value | json
      echo '}'
      assign property_count = property_count | plus: 1
    endif
    assign fit_value = product.metafields.custom.patio_furniture_fit.value | strip
    if fit_value != blank
      if property_count > 0
        echo ','
      endif
      echo '{"@type":"PropertyValue","name":"Furniture fit","value":'
      echo fit_value | json
      echo '}'
      assign property_count = property_count | plus: 1
    endif
    if product.type != blank
      if property_count > 0
        echo ','
      endif
      echo '{"@type":"PropertyValue","name":"Product type","value":'
      echo product.type | json
      echo '}'
      assign property_count = property_count | plus: 1
    endif
  endcapture

  assign complementary_products = product.metafields['shopify--discovery--product_recommendation'].complementary_products.value
  assign related_products = product.metafields['shopify--discovery--product_recommendation'].related_products.value

  assign subject_count = 0
  capture subject_of
    for product_media in product.media
      if product_media.media_type == 'video' or product_media.media_type == 'external_video'
        assign video_url = ''
        if product_media.media_type == 'video'
          assign mp4_source = product_media.sources | where: 'format', 'mp4' | first
          assign video_url = mp4_source.url
        elsif product_media.host == 'youtube'
          assign video_url = 'https://www.youtube.com/embed/' | append: product_media.external_id
        elsif product_media.host == 'vimeo'
          assign video_url = 'https://player.vimeo.com/video/' | append: product_media.external_id
        endif
        if video_url != blank and product_media.preview_image
          if subject_count > 0
            echo ','
          endif
          echo '{"@type":"VideoObject","name":'
          echo product_media.alt | default: product.title | json
          echo ',"description":'
          echo product_description | default: product.title | json
          echo ',"thumbnailUrl":'
          echo product_media.preview_image | image_url: width: 1200 | prepend: 'https:' | json
          echo ',"uploadDate":'
          echo product.published_at | date: '%Y-%m-%dT%H:%M:%S%z' | json
          if product_media.media_type == 'video'
            echo ',"contentUrl":'
          else
            echo ',"embedUrl":'
          endif
          echo video_url | json
          echo '}'
          assign subject_count = subject_count | plus: 1
        endif
      endif
    endfor
  endcapture
-%}

{%- capture variant_nodes -%}
  {%- for variant in product.variants -%}
    {%- liquid
      assign variant_url = site_url | append: variant.url
      assign barcode = variant.barcode | strip | remove: ' ' | remove: '-'
      assign barcode_size = barcode | size
      assign gtin_valid = false
      if barcode_size == 8 or barcode_size == 12 or barcode_size == 13 or barcode_size == 14
        assign non_digits = barcode | remove: '0' | remove: '1' | remove: '2' | remove: '3' | remove: '4' | remove: '5' | remove: '6' | remove: '7' | remove: '8' | remove: '9'
        if non_digits == ''
          assign gtin_sum = 0
          assign data_last = barcode_size | minus: 2
          for digit_index in (0..data_last)
            assign gtin_digit = barcode | slice: digit_index | plus: 0
            assign weight_test = data_last | minus: digit_index | modulo: 2
            if weight_test == 0
              assign gtin_digit = gtin_digit | times: 3
            endif
            assign gtin_sum = gtin_sum | plus: gtin_digit
          endfor
          assign expected_check = gtin_sum | modulo: 10 | times: -1 | plus: 10 | modulo: 10
          assign actual_check = barcode | slice: -1 | plus: 0
          if expected_check == actual_check
            assign gtin_valid = true
          endif
        endif
      endif
      assign variant_image = variant.featured_image | default: product.featured_image
      assign variant_price = variant.price | money_without_currency | remove: ','
    -%}
    {%- capture variant_identity -%}
      {%- if variant.sku != blank -%}
        "sku": {{ variant.sku | json }},
        "mpn": {{ variant.sku | json }},
      {%- endif -%}
      {%- if gtin_valid -%}
        "gtin{{ barcode_size }}": {{ barcode | json }},
      {%- endif -%}
      {%- if color_index >= 0 -%}
        "color": {{ variant.options[color_index] | json }},
      {%- endif -%}
      {%- if size_index >= 0 -%}
        "size": {{ variant.options[size_index] | json }},
      {%- endif -%}
    {%- endcapture -%}
    {%- capture variant_offer -%}
      "offers": {
        "@type": "Offer",
        "url": {{ variant_url | json }},
        "price": {{ variant_price | json }},
        "priceCurrency": {{ schema_currency | json }},
        {%- if settings.schema_show_strikethrough and variant.compare_at_price > variant.price -%}
          "priceSpecification": {
            "@type": "UnitPriceSpecification",
            "priceType": "https://schema.org/StrikethroughPrice",
            "price": {{ variant.compare_at_price | money_without_currency | remove: ',' | json }},
            "priceCurrency": {{ schema_currency | json }}
          },
        {%- endif -%}
        "availability": "https://schema.org/{% if variant.available %}InStock{% else %}OutOfStock{% endif %}",
        "itemCondition": "https://schema.org/NewCondition",
        "seller": {"@id": {{ org_id | json }}},
        "shippingDetails": {"@id": {{ shipping_id | json }}},
        "hasMerchantReturnPolicy": {"@id": {{ return_ref | json }}}
      }
    {%- endcapture -%}
    {%- if is_group -%}
      {
        "@type": "Product",
        "@id": {{ variant_url | append: '#variant' | json }},
        "name": {{ product.title | append: ' - ' | append: variant.title | json }},
        {%- if product_description != blank -%}
          "description": {{ product_description | json }},
        {%- endif -%}
        {{- variant_identity -}}
        {%- if variant_image -%}
          "image": {{ variant_image | image_url: width: 1200 | prepend: 'https:' | json }},
        {%- endif -%}
        "inProductGroupWithID": {{ product.id | append: '' | json }},
        {{- variant_offer -}}
      }{%- unless forloop.last -%},{%- endunless -%}
    {%- else -%}
      {{- variant_identity -}}
      {{- variant_offer -}}
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}

,{
  "@type": {% if is_group %}"ProductGroup"{% else %}"Product"{% endif %},
  "@id": {{ product_id | json }},
  "url": {{ product_url | json }},
  "name": {{ product.title | json }},
  {%- if product_description != blank -%}
    "description": {{ product_description | json }},
  {%- endif -%}
  {%- if product.images.size > 0 -%}
    "image": [
      {%- for product_image in product.images limit: 10 -%}
        {{ product_image | image_url: width: 1200 | prepend: 'https:' | json }}{%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    ],
  {%- endif -%}
  {%- if product.vendor != blank -%}
    "brand": {"@id": {{ brand_id | json }}},
  {%- endif -%}
  {%- if is_own_brand -%}
    "manufacturer": {"@id": {{ org_id | json }}},
  {%- endif -%}
  {%- if product_category != blank -%}
    "category": {{ product_category | json }},
  {%- endif -%}
  {%- if property_count > 0 -%}
    "additionalProperty": [{{ additional_properties }}],
  {%- endif -%}
  {%- if complementary_products.size > 0 -%}
    "isRelatedTo": [
      {%- for related in complementary_products limit: 4 -%}
        {"@type": "Product", "name": {{ related.title | json }}, "url": {{ site_url | append: related.url | json }}}{%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    ],
  {%- endif -%}
  {%- if related_products.size > 0 -%}
    "isSimilarTo": [
      {%- for related in related_products limit: 4 -%}
        {"@type": "Product", "name": {{ related.title | json }}, "url": {{ site_url | append: related.url | json }}}{%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    ],
  {%- endif -%}
  {%- if subject_count > 0 -%}
    "subjectOf": [{{ subject_of }}],
  {%- endif -%}
  {%- if product.metafields.reviews.rating.value != blank and product.metafields.reviews.rating_count.value > 0 -%}
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": {{ product.metafields.reviews.rating.value.rating | json }},
      "bestRating": {{ product.metafields.reviews.rating.value.scale_max | json }},
      "reviewCount": {{ product.metafields.reviews.rating_count.value | json }}
    },
  {%- endif -%}
  {%- if is_group -%}
    "productGroupID": {{ product.id | append: '' | json }},
    {%- if color_index >= 0 or size_index >= 0 -%}
      "variesBy": [
        {%- if color_index >= 0 -%}"https://schema.org/color"{%- endif -%}
        {%- if color_index >= 0 and size_index >= 0 -%},{%- endif -%}
        {%- if size_index >= 0 -%}"https://schema.org/size"{%- endif -%}
      ],
    {%- endif -%}
    "hasVariant": [{{ variant_nodes }}]
  {%- else -%}
    {{- variant_nodes -}}
  {%- endif -%}
}

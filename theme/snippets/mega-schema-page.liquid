{%- doc -%}
  Outputs the page-level JSON-LD nodes for the MegaSchema @graph: the page node (WebPage, ItemPage,
  CollectionPage, AboutPage, ContactPage or SearchResultsPage), its BreadcrumbList, and the collection
  ItemList, Blog or BlogPosting when the page has one.
  Product and collection breadcrumbs follow the store's collection hierarchy, up to the depth in the
  "Breadcrumb depth" setting (Home counts as one level). A collection's parent is its
  custom.parent_collection metafield, then its custom.breadcrumb_parent_collection metafield (a name some
  themes already use for their visible breadcrumbs), or else the collection whose custom.subcollections
  list includes it.
  On product pages without collection context, a collection that has a parent is preferred, so the
  trail is as specific as possible. Loops in the hierarchy stop the walk. Collections listed in
  "Collections to skip in breadcrumbs" never start a product trail, and their own pages get no BreadcrumbList.
  Each node is preceded by a comma; snippets/mega-schema.liquid removes the leading one.

  @param {string} site_url - The store's primary URL without a trailing slash
  @param {string} page_url - The page's canonical URL
{%- enddoc -%}

{%- liquid
  assign org_id = site_url | append: '/#organization'
  assign website_id = site_url | append: '/#website'
  assign webpage_id = page_url | append: '#webpage'
  assign breadcrumb_id = page_url | append: '#breadcrumb'
  assign has_breadcrumb = true
  assign page_type = 'WebPage'
  assign main_entity_id = ''
  assign about_id = ''
  assign page_image = ''

  case request.page_type
    when 'index'
      assign has_breadcrumb = false
      assign about_id = org_id
    when 'product'
      assign page_type = 'ItemPage'
      assign main_entity_id = site_url | append: product.url
      assign page_image = product.featured_image
    when 'collection'
      assign page_type = 'CollectionPage'
      assign main_entity_id = page_url | append: '#itemlist'
      assign page_image = collection.image
    when 'blog'
      assign main_entity_id = page_url | append: '#blog'
    when 'article'
      assign main_entity_id = page_url | append: '#article'
      assign page_image = article.image
    when 'page'
      if page.handle contains 'about'
        assign page_type = 'AboutPage'
        assign main_entity_id = org_id
      elsif page.handle == 'contact' or page.template_suffix == 'contact'
        assign page_type = 'ContactPage'
        assign main_entity_id = org_id
      endif
    when 'search'
      assign page_type = 'SearchResultsPage'
    when '404', 'cart', 'password'
      assign has_breadcrumb = false
  endcase

  assign excluded_handles = settings.schema_breadcrumb_exclude | remove: ' ' | split: ','
  if request.page_type == 'collection' and excluded_handles contains collection.handle
    assign has_breadcrumb = false
  endif

  assign crumb_names = ''
  assign crumb_urls = ''
  if has_breadcrumb
    assign max_depth = settings.schema_breadcrumb_max_depth | default: 5
    assign parent_map = '|'
    if request.page_type == 'product' or request.page_type == 'collection'
      if settings.schema_breadcrumb_use_subcollections
        for map_collection in collections
          assign map_children = map_collection.metafields.custom.subcollections.value
          for map_child in map_children
            assign parent_map = parent_map | append: map_child.handle | append: '>' | append: map_collection.handle | append: '|'
          endfor
        endfor
      endif
    endif

    assign chain_start = ''
    assign leaf_name = ''
    assign leaf_url = ''
    assign ancestor_limit = 0

    case request.page_type
      when 'product'
        assign crumb_collection = collection
        if crumb_collection != blank and excluded_handles contains crumb_collection.handle
          assign crumb_collection = ''
        endif
        if crumb_collection == blank
          assign fallback_collection = ''
          for product_collection in product.collections
            if excluded_handles contains product_collection.handle
              continue
            endif
            if fallback_collection == ''
              assign fallback_collection = product_collection
            endif
            assign has_parent = false
            if product_collection.metafields.custom.parent_collection.value != blank
              assign has_parent = true
            endif
            if product_collection.metafields.custom.breadcrumb_parent_collection.value != blank
              assign has_parent = true
            endif
            assign map_key = '|' | append: product_collection.handle | append: '>'
            if parent_map contains map_key
              assign has_parent = true
            endif
            if has_parent
              assign crumb_collection = product_collection
              break
            endif
          endfor
          if crumb_collection == blank and fallback_collection != ''
            assign crumb_collection = fallback_collection
          endif
        endif
        if crumb_collection != blank
          assign chain_start = crumb_collection
        endif
        assign leaf_name = product.title
        assign leaf_url = site_url | append: product.url
        assign ancestor_limit = max_depth | minus: 3
      when 'collection'
        assign chain_start = collection
        assign ancestor_limit = max_depth | minus: 2
      when 'blog'
        assign crumb_names = blog.title
        assign crumb_urls = page_url
      when 'article'
        assign crumb_names = blog.title | append: '|~|' | append: article.title
        assign crumb_urls = site_url | append: blog.url | append: '|~|' | append: page_url
      when 'page'
        assign crumb_names = page.title
        assign crumb_urls = page_url
      else
        assign crumb_names = page_title
        assign crumb_urls = page_url
    endcase

    if chain_start != blank and chain_start != ''
      assign crumb_names = chain_start.title
      assign crumb_urls = site_url | append: chain_start.url
      assign visited = '|' | append: chain_start.handle | append: '|'
      assign current_collection = chain_start
      if ancestor_limit > 0
        for step in (1..ancestor_limit)
          assign parent_collection = current_collection.metafields.custom.parent_collection.value
          if parent_collection == blank
            assign parent_collection = current_collection.metafields.custom.breadcrumb_parent_collection.value
          endif
          if parent_collection == blank
            assign map_key = '|' | append: current_collection.handle | append: '>'
            if parent_map contains map_key
              assign parent_handle = parent_map | split: map_key | last | split: '|' | first
              assign parent_collection = collections[parent_handle]
            endif
          endif
          if parent_collection == blank
            break
          endif
          assign visit_key = '|' | append: parent_collection.handle | append: '|'
          if visited contains visit_key
            break
          endif
          assign visited = visited | append: parent_collection.handle | append: '|'
          assign crumb_names = parent_collection.title | append: '|~|' | append: crumb_names
          assign crumb_urls = site_url | append: parent_collection.url | append: '|~|' | append: crumb_urls
          assign current_collection = parent_collection
        endfor
      endif
    endif
    if leaf_name != ''
      if crumb_names != ''
        assign crumb_names = crumb_names | append: '|~|'
        assign crumb_urls = crumb_urls | append: '|~|'
      endif
      assign crumb_names = crumb_names | append: leaf_name
      assign crumb_urls = crumb_urls | append: leaf_url
    endif
  endif
  assign crumb_name_list = crumb_names | split: '|~|'
  assign crumb_url_list = crumb_urls | split: '|~|'
-%}

,{
  "@type": {{ page_type | json }},
  "@id": {{ webpage_id | json }},
  "url": {{ page_url | json }},
  "name": {{ page_title | replace: '&amp;', '&' | replace: '&quot;', '"' | replace: '&#39;', "'" | strip | json }},
  {%- if page_description != blank -%}
    "description": {{ page_description | replace: '&amp;', '&' | replace: '&quot;', '"' | replace: '&#39;', "'" | strip | json }},
  {%- endif -%}
  {%- if page_image != blank -%}
    "primaryImageOfPage": {
      "@type": "ImageObject",
      "url": {{ page_image | image_url: width: 1200 | prepend: 'https:' | json }}
    },
  {%- endif -%}
  {%- if main_entity_id != blank -%}
    "mainEntity": {"@id": {{ main_entity_id | json }}},
  {%- endif -%}
  {%- if about_id != blank -%}
    "about": {"@id": {{ about_id | json }}},
  {%- endif -%}
  {%- if has_breadcrumb and crumb_name_list.size > 0 -%}
    "breadcrumb": {"@id": {{ breadcrumb_id | json }}},
  {%- endif -%}
  "inLanguage": {{ request.locale.iso_code | json }},
  "isPartOf": {"@id": {{ website_id | json }}}
}

{%- if has_breadcrumb and crumb_name_list.size > 0 -%}
  ,{
    "@type": "BreadcrumbList",
    "@id": {{ breadcrumb_id | json }},
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": {{ site_url | json }}
      }
      {%- for crumb_name in crumb_name_list -%}
        ,{
          "@type": "ListItem",
          "position": {{ forloop.index | plus: 1 }},
          "name": {{ crumb_name | strip | json }},
          "item": {{ crumb_url_list[forloop.index0] | json }}
        }
      {%- endfor -%}
    ]
  }
{%- endif -%}

{%- if request.page_type == 'collection' -%}
  ,{
    "@type": "ItemList",
    "@id": {{ page_url | append: '#itemlist' | json }},
    "name": {{ collection.title | json }},
    {%- assign collection_description = collection.description | strip_html | strip | truncate: 300 -%}
    {%- if collection_description != blank -%}
      "description": {{ collection_description | json }},
    {%- endif -%}
    "numberOfItems": {{ collection.products_count }},
    "itemListElement": [
      {%- for listed_product in collection.products limit: 24 -%}
        {
          "@type": "ListItem",
          "position": {{ forloop.index }},
          "url": {{ site_url | append: listed_product.url | json }},
          "name": {{ listed_product.title | json }}
        }{%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    ]
  }
{%- endif -%}

{%- if request.page_type == 'blog' -%}
  ,{
    "@type": "Blog",
    "@id": {{ page_url | append: '#blog' | json }},
    "name": {{ blog.title | json }},
    "url": {{ page_url | json }},
    "publisher": {"@id": {{ org_id | json }}},
    "blogPost": [
      {%- for blog_article in blog.articles limit: 20 -%}
        {%- assign article_url = site_url | append: blog_article.url -%}
        {
          "@type": "BlogPosting",
          "@id": {{ article_url | append: '#article' | json }},
          "headline": {{ blog_article.title | json }},
          "url": {{ article_url | json }},
          {%- if blog_article.image -%}
            "image": {{ blog_article.image | image_url: width: 1200 | prepend: 'https:' | json }},
          {%- endif -%}
          "datePublished": {{ blog_article.published_at | date: '%Y-%m-%dT%H:%M:%S%z' | json }},
          "dateModified": {{ blog_article.updated_at | date: '%Y-%m-%dT%H:%M:%S%z' | json }},
          {%- if blog_article.author == blank or blog_article.author == shop.name -%}
            "author": {"@id": {{ org_id | json }}}
          {%- else -%}
            "author": {"@type": "Person", "name": {{ blog_article.author | json }}}
          {%- endif -%}
        }{%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    ]
  }
{%- endif -%}

{%- if request.page_type == 'article' -%}
  {%- liquid
    assign article_description = article.excerpt | newline_to_br | replace: '<', ' <' | strip_html | strip_newlines | replace: '&amp;', '&' | replace: '&nbsp;', ' ' | replace: '&quot;', '"' | replace: '&#39;', "'" | split: ' ' | join: ' ' | strip
    if article_description == blank
      assign article_description = article.content | newline_to_br | replace: '<', ' <' | strip_html | strip_newlines | replace: '&amp;', '&' | replace: '&nbsp;', ' ' | replace: '&quot;', '"' | replace: '&#39;', "'" | split: ' ' | join: ' ' | strip | truncate: 300
    endif
  -%}
  ,{
    "@type": "BlogPosting",
    "@id": {{ page_url | append: '#article' | json }},
    "headline": {{ article.title | json }},
    "url": {{ page_url | json }},
    {%- if article_description != blank -%}
      "description": {{ article_description | json }},
    {%- endif -%}
    {%- if article.image -%}
      "image": [{{ article.image | image_url: width: 1200 | prepend: 'https:' | json }}],
    {%- endif -%}
    "datePublished": {{ article.published_at | date: '%Y-%m-%dT%H:%M:%S%z' | json }},
    "dateModified": {{ article.updated_at | date: '%Y-%m-%dT%H:%M:%S%z' | json }},
    {%- if article.author == blank or article.author == shop.name -%}
      "author": {"@id": {{ org_id | json }}},
    {%- else -%}
      "author": {"@type": "Person", "name": {{ article.author | json }}},
    {%- endif -%}
    "publisher": {"@id": {{ org_id | json }}},
    "mainEntityOfPage": {"@id": {{ webpage_id | json }}},
    "isPartOf": {
      "@type": "Blog",
      "@id": {{ site_url | append: blog.url | append: '#blog' | json }},
      "name": {{ blog.title | json }},
      "url": {{ site_url | append: blog.url | json }}
    },
    "inLanguage": {{ request.locale.iso_code | json }}
  }
{%- endif -%}
